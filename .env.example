ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080
WEB_HTTP_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slack_app
POSTGRES_USER=slack_app
POSTGRES_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
PRESENCE_STORE=Redis
PRESENCE_HEARTBEAT_INTERVAL_SECONDS=20
PRESENCE_HEARTBEAT_TTL_SECONDS=75
PRESENCE_AFK_THRESHOLD_SECONDS=60
PRESENCE_SWEEP_INTERVAL_SECONDS=15

UPLOADS_ROOT=./data/uploads
STORAGE_MAX_UPLOAD_BYTES=10485760

# Keep these blank to let the frontend auto-match the browser host in local dev,
# or set them explicitly if the API is running on a different host.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SIGNALR_URL=
