{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Presence": {
    "Store": "InMemory",
    "HeartbeatIntervalSeconds": 20,
    "HeartbeatTtlSeconds": 75,
    "AfkThresholdSeconds": 60,
    "SweepIntervalSeconds": 15
  },
  "Storage": {
    "UploadsRoot": "uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
