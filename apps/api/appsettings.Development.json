{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=slack_app;Username=slack_app;Password=change-me",
    "Redis": "localhost:6379"
  },
  "Presence": {
    "Store": "InMemory",
    "HeartbeatIntervalSeconds": 20,
    "HeartbeatTtlSeconds": 75,
    "AfkThresholdSeconds": 60,
    "SweepIntervalSeconds": 15
  },
  "Storage": {
    "UploadsRoot": "data/uploads"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
